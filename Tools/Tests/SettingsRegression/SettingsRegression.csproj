<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/Settings.utf8.cs" Link="Settings.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildToolsPath)/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="PrepareSettingsSource" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/prepare_source.py&quot;" />
  </Target>
</Project>
